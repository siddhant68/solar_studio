{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://solar-studio.invalid/schemas/solar.terrain.placement.result/1",
 "title": "solar.terrain.placement.result/1",
 "description": "Summary and record shapes of an immutable terrain placement. Records are paged like Module 01 items (kind = tables | modules | supports). The relations between counts and records, the absence of module/support records for unknown_ground tables and the numerical checks are semantic rules enforced by the independent verifier (CONTRACTS.md sections 5-6).",
 "$defs": {
  "table_record": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "seq": {
     "type": "integer",
     "minimum": 0
    },
    "table_id": {
     "type": "string",
     "pattern": "^T_j-?[0-9]+_i-?[0-9]+$",
     "description": "Module 01 table_id; unique only together with the summary's source result_id and payload_digest."
    },
    "status": {
     "enum": [
      "placed",
      "unknown_ground",
      "infeasible"
     ]
    },
    "reasons": {
     "type": "array",
     "uniqueItems": true,
     "items": {
      "enum": [
       "footprint_not_fully_covered",
       "ground_slope_exceeds_limit",
       "support_above_ground_exceeds_limit"
      ]
     }
    },
    "module_count": {
     "type": "integer",
     "minimum": 1
    },
    "footprint_xy_m": {
     "type": "array",
     "minItems": 4,
     "maxItems": 4,
     "items": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
       "type": "number"
      }
     },
     "description": "Copied unchanged from the Module 01 table record."
    },
    "covered_area_m2": {
     "type": "number",
     "minimum": 0
    },
    "uncovered_area_m2": {
     "type": "number",
     "minimum": 0
    },
    "lower_edge_z_m": {
     "type": "number"
    },
    "upper_edge_z_m": {
     "type": "number"
    },
    "vertical_lift_m": {
     "type": "number"
    },
    "min_clearance_m": {
     "type": "number"
    },
    "min_clearance_at_xy_m": {
     "type": "array",
     "minItems": 2,
     "maxItems": 2,
     "items": {
      "type": "number"
     }
    },
    "max_clearance_m": {
     "type": "number"
    },
    "max_ground_slope_deg": {
     "type": "number",
     "minimum": 0,
     "maximum": 90
    },
    "mean_ground_gradient_uv": {
     "type": "array",
     "minItems": 2,
     "maxItems": 2,
     "items": {
      "type": "number"
     }
    }
   },
   "required": [
    "seq",
    "table_id",
    "status",
    "reasons",
    "module_count",
    "footprint_xy_m",
    "covered_area_m2",
    "uncovered_area_m2"
   ],
   "oneOf": [
    {
     "properties": {
      "status": {
       "const": "placed"
      },
      "reasons": {
       "maxItems": 0
      }
     },
     "required": [
      "lower_edge_z_m",
      "upper_edge_z_m",
      "vertical_lift_m",
      "min_clearance_m",
      "min_clearance_at_xy_m",
      "max_clearance_m",
      "max_ground_slope_deg",
      "mean_ground_gradient_uv"
     ]
    },
    {
     "properties": {
      "status": {
       "const": "infeasible"
      },
      "reasons": {
       "minItems": 1,
       "items": {
        "enum": [
         "ground_slope_exceeds_limit",
         "support_above_ground_exceeds_limit"
        ]
       }
      }
     },
     "required": [
      "lower_edge_z_m",
      "upper_edge_z_m",
      "vertical_lift_m",
      "min_clearance_m",
      "min_clearance_at_xy_m",
      "max_clearance_m",
      "max_ground_slope_deg",
      "mean_ground_gradient_uv"
     ]
    },
    {
     "properties": {
      "status": {
       "const": "unknown_ground"
      },
      "reasons": {
       "const": [
        "footprint_not_fully_covered"
       ]
      },
      "uncovered_area_m2": {
       "type": "number",
       "exclusiveMinimum": 0
      }
     },
     "not": {
      "anyOf": [
       {
        "required": [
         "lower_edge_z_m"
        ]
       },
       {
        "required": [
         "upper_edge_z_m"
        ]
       },
       {
        "required": [
         "vertical_lift_m"
        ]
       },
       {
        "required": [
         "min_clearance_m"
        ]
       },
       {
        "required": [
         "min_clearance_at_xy_m"
        ]
       },
       {
        "required": [
         "max_clearance_m"
        ]
       },
       {
        "required": [
         "max_ground_slope_deg"
        ]
       },
       {
        "required": [
         "mean_ground_gradient_uv"
        ]
       }
      ]
     }
    }
   ]
  },
  "module_record": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "seq",
    "module_id",
    "table_id",
    "corners_xyz_m"
   ],
   "properties": {
    "seq": {
     "type": "integer",
     "minimum": 0
    },
    "module_id": {
     "type": "string",
     "pattern": "^T_j-?[0-9]+_i-?[0-9]+_r[0-9]+_c[0-9]+$"
    },
    "table_id": {
     "type": "string",
     "pattern": "^T_j-?[0-9]+_i-?[0-9]+$",
     "description": "Module 01 table_id; unique only together with the summary's source result_id and payload_digest."
    },
    "corners_xyz_m": {
     "type": "array",
     "minItems": 4,
     "maxItems": 4,
     "items": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
       "type": "number"
      }
     },
     "description": "Module 01 corners with z + vertical_lift_m; x and y unchanged. Placed tables only."
    }
   }
  },
  "support_record": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "seq",
    "support_id",
    "table_id",
    "a_m",
    "d_m",
    "xy_m",
    "ground_z_m",
    "top_z_m",
    "above_ground_m"
   ],
   "properties": {
    "seq": {
     "type": "integer",
     "minimum": 0
    },
    "support_id": {
     "type": "string",
     "pattern": "^S_T_j-?[0-9]+_i-?[0-9]+_[0-9]+$"
    },
    "table_id": {
     "type": "string",
     "pattern": "^T_j-?[0-9]+_i-?[0-9]+$",
     "description": "Module 01 table_id; unique only together with the summary's source result_id and payload_digest."
    },
    "a_m": {
     "type": "number",
     "minimum": 0
    },
    "d_m": {
     "type": "number",
     "minimum": 0
    },
    "xy_m": {
     "type": "array",
     "minItems": 2,
     "maxItems": 2,
     "items": {
      "type": "number"
     }
    },
    "ground_z_m": {
     "type": "number"
    },
    "top_z_m": {
     "type": "number"
    },
    "above_ground_m": {
     "type": "number",
     "description": "top_z_m - ground_z_m. Not an embedment depth or a pile length."
    }
   }
  },
  "not_computed": {
   "const": [
    "embedment_depth",
    "pile_length",
    "foundation_design",
    "structural_adequacy",
    "grading",
    "cut_fill",
    "drainage"
   ]
  }
 },
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema_version",
  "placement_id",
  "source_layout",
  "terrain",
  "parameters_digest",
  "frame",
  "vertical",
  "z_kind",
  "policy",
  "counts",
  "statistics",
  "diagnostics",
  "warnings",
  "not_computed",
  "provenance",
  "verification",
  "payload_digest"
 ],
 "properties": {
  "schema_version": {
   "const": "solar.terrain.placement.result/1"
  },
  "placement_id": {
   "type": "string",
   "pattern": "^plc_[0-9a-f]{24}$"
  },
  "source_layout": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "result_id",
    "payload_digest",
    "schema_version",
    "algorithm_version"
   ],
   "properties": {
    "result_id": {
     "type": "string",
     "pattern": "^res_[0-9a-f]{24}$"
    },
    "payload_digest": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "schema_version": {
     "type": "string"
    },
    "algorithm_version": {
     "type": "string"
    }
   }
  },
  "terrain": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "terrain_id",
    "terrain_digest"
   ],
   "properties": {
    "terrain_id": {
     "type": "string",
     "pattern": "^ter_[0-9a-f]{24}$"
    },
    "terrain_digest": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    }
   }
  },
  "parameters_digest": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "frame": {
   "type": "object",
   "required": [
    "kind",
    "id",
    "units",
    "axes"
   ],
   "properties": {
    "kind": {
     "enum": [
      "local_cartesian",
      "projected_cartesian"
     ]
    },
    "id": {
     "type": "string"
    },
    "crs": {
     "type": [
      "string",
      "null"
     ]
    },
    "units": {
     "const": "m"
    },
    "axes": {
     "type": "object"
    }
   }
  },
  "vertical": {
   "type": "object",
   "required": [
    "kind",
    "units",
    "positive"
   ],
   "properties": {
    "kind": {
     "enum": [
      "orthometric",
      "ellipsoidal",
      "local"
     ]
    },
    "crs": {
     "type": [
      "string",
      "null"
     ]
    },
    "id": {
     "type": "string"
    },
    "units": {
     "const": "m"
    },
    "positive": {
     "const": "up"
    }
   }
  },
  "z_kind": {
   "const": "terrain_vertical_reference"
  },
  "policy": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "policy",
    "minimum_clearance_m",
    "structure_depth_m",
    "supports_model",
    "limits",
    "coverage",
    "numerical_policy"
   ],
   "properties": {
    "policy": {
     "const": "minimum_clearance_vertical_lift"
    },
    "minimum_clearance_m": {
     "type": "number",
     "minimum": 0
    },
    "structure_depth_m": {
     "type": "number",
     "minimum": 0
    },
    "supports_model": {
     "const": "explicit_table_local"
    },
    "limits": {
     "type": "object"
    },
    "coverage": {
     "const": "mark_unknown_ground"
    },
    "numerical_policy": {
     "const": "terrain-policy/1"
    }
   }
  },
  "counts": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "tables",
    "placed_tables",
    "unknown_ground_tables",
    "infeasible_tables",
    "placed_modules",
    "placed_dc_capacity_kwp",
    "supports"
   ],
   "properties": {
    "tables": {
     "type": "integer",
     "minimum": 0
    },
    "placed_tables": {
     "type": "integer",
     "minimum": 0
    },
    "unknown_ground_tables": {
     "type": "integer",
     "minimum": 0
    },
    "infeasible_tables": {
     "type": "integer",
     "minimum": 0
    },
    "placed_modules": {
     "type": "integer",
     "minimum": 0
    },
    "placed_dc_capacity_kwp": {
     "type": "number",
     "minimum": 0
    },
    "supports": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "statistics": {
   "type": "object"
  },
  "diagnostics": {
   "type": "object"
  },
  "warnings": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "not_computed": {
   "const": [
    "embedment_depth",
    "pile_length",
    "foundation_design",
    "structural_adequacy",
    "grading",
    "cut_fill",
    "drainage"
   ]
  },
  "provenance": {
   "type": "object",
   "required": [
    "algorithm_version",
    "policy_version",
    "schema_version",
    "software_version",
    "source_commit",
    "source_tree_dirty",
    "dependencies",
    "created_at"
   ],
   "properties": {
    "algorithm_version": {
     "const": "terrain-vertical-lift/1"
    },
    "policy_version": {
     "const": "terrain-policy/1"
    },
    "schema_version": {
     "type": "string"
    },
    "software_version": {
     "type": "string"
    },
    "source_commit": {
     "type": [
      "string",
      "null"
     ]
    },
    "source_tree_dirty": {
     "type": [
      "boolean",
      "null"
     ]
    },
    "dependencies": {
     "type": "object"
    },
    "created_at": {
     "type": "string"
    }
   }
  },
  "verification": {
   "type": "object",
   "required": [
    "ok",
    "checks"
   ],
   "properties": {
    "ok": {
     "const": true
    },
    "checks": {
     "type": "object"
    }
   }
  },
  "payload_digest": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  }
 }
}