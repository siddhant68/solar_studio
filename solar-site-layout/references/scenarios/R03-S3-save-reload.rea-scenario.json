{
 "browser": {
  "mode": "launch",
  "executable_path": "/home/user/work/tools/chromium-offline.sh",
  "headless": true
 },
 "start_url": {
  "url": "http://127.0.0.1:4173/",
  "query": []
 },
 "actions": [
  {
   "step_id": "app_visible",
   "action": "wait_for",
   "locator": {
    "kind": "test_id",
    "value": "app-root"
   },
   "state": "visible",
   "timeout_ms": 60000
  },
  {
   "step_id": "example_settle",
   "action": "wait_for_timeout",
   "duration_ms": 5000
  },
  {
   "step_id": "open_panels_step",
   "action": "click",
   "locator": {
    "kind": "test_id",
    "value": "action-step-panels"
   },
   "timeout_ms": 30000
  },
  {
   "step_id": "open_by_hand_fold",
   "action": "click",
   "locator": {
    "kind": "css",
    "selector": "[data-testid=\"details-panels-by-hand\"] > summary"
   },
   "timeout_ms": 30000
  },
  {
   "step_id": "row_count_visible",
   "action": "wait_for",
   "locator": {
    "kind": "test_id",
    "value": "control-array-row-count"
   },
   "state": "visible",
   "timeout_ms": 30000
  },
  {
   "step_id": "set_tilt_33",
   "action": "fill",
   "locator": {
    "kind": "test_id",
    "value": "control-array-tilt"
   },
   "value": {
    "source": "literal",
    "value": "33"
   }
  },
  {
   "step_id": "set_pitch_7_5",
   "action": "fill",
   "locator": {
    "kind": "test_id",
    "value": "control-array-pitch"
   },
   "value": {
    "source": "literal",
    "value": "7.5"
   }
  },
  {
   "step_id": "open_check_step",
   "action": "click",
   "locator": {
    "kind": "test_id",
    "value": "action-step-check"
   },
   "timeout_ms": 30000
  },
  {
   "step_id": "save_design",
   "action": "click",
   "locator": {
    "kind": "test_id",
    "value": "action-storage-save"
   },
   "timeout_ms": 30000
  },
  {
   "step_id": "saved_settle",
   "action": "wait_for_timeout",
   "duration_ms": 1500
  },
  {
   "step_id": "reload",
   "action": "goto",
   "destination": {
    "url": "http://127.0.0.1:4173/",
    "query": []
   },
   "wait_until": "load",
   "timeout_ms": 60000
  },
  {
   "step_id": "reload_app_visible",
   "action": "wait_for",
   "locator": {
    "kind": "test_id",
    "value": "app-root"
   },
   "state": "visible",
   "timeout_ms": 60000
  },
  {
   "step_id": "reload_settle",
   "action": "wait_for_timeout",
   "duration_ms": 5000
  },
  {
   "step_id": "reopen_panels_step",
   "action": "click",
   "locator": {
    "kind": "test_id",
    "value": "action-step-panels"
   },
   "timeout_ms": 30000
  },
  {
   "step_id": "reopen_by_hand_fold",
   "action": "click",
   "locator": {
    "kind": "css",
    "selector": "[data-testid=\"details-panels-by-hand\"] > summary"
   },
   "timeout_ms": 30000
  },
  {
   "step_id": "reopen_settle",
   "action": "wait_for_timeout",
   "duration_ms": 1000
  }
 ],
 "capture": {
  "after_each_step": [],
  "at_end": [
   "screenshot",
   "dom",
   "storage",
   "url"
  ],
  "events": []
 },
 "command_timeout_ms": 300000
}