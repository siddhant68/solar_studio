{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solar-studio.local/schemas/solar.layout.request.v1.schema.json",
  "title": "solar.layout.request/1",
  "description": "Flat-site layout request in an explicitly named metric Cartesian frame (x East, y North, metres). Structural rules only: geometry validity, the supported envelope, frame semantics and pitch feasibility are checked after this schema by the application and reported as typed field errors.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "frame", "boundary", "perimeter_setback_m", "exclusions", "module", "table", "placement"],
  "properties": {
    "schema_version": {"const": "solar.layout.request/1"},
    "name": {"type": "string", "maxLength": 200},
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "units", "axes"],
      "properties": {
        "kind": {"type": "string", "description": "local_cartesian or projected_cartesian; other values are rejected as UNSUPPORTED_FRAME."},
        "id": {"type": "string", "minLength": 1, "maxLength": 200},
        "crs": {"type": "string", "minLength": 1, "maxLength": 200, "description": "Required for projected_cartesian. Retained verbatim; no transformation is performed."},
        "units": {"type": "string", "description": "Must be \"m\"; other values are rejected as UNSUPPORTED_FRAME."},
        "axes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {"x": {"type": "string"}, "y": {"type": "string"}}
        }
      }
    },
    "boundary": {"$ref": "#/$defs/areal_geometry"},
    "perimeter_setback_m": {"type": "number", "minimum": 0, "maximum": 1000},
    "exclusions": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "geometry", "keepout_m"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 100},
          "geometry": {"$ref": "#/$defs/areal_geometry"},
          "keepout_m": {"type": "number", "minimum": 0, "maximum": 1000}
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "width_m", "length_m", "power_wp", "orientation"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "width_m": {"type": "number", "exclusiveMinimum": 0, "description": "Short side. Supported envelope 0.05..10 m."},
        "length_m": {"type": "number", "exclusiveMinimum": 0, "description": "Long side (>= width_m). Supported envelope 0.05..10 m."},
        "power_wp": {"type": "number", "exclusiveMinimum": 0, "maximum": 5000, "description": "Nameplate STC power; the only electrical rating used."},
        "orientation": {"enum": ["portrait", "landscape"]}
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows", "columns", "module_gap_x_m", "module_gap_y_m", "tilt_deg", "facing_azimuth_deg", "lower_edge_height_m"],
      "properties": {
        "rows": {"type": "integer", "minimum": 1, "maximum": 50, "description": "Modules up the slope (along v)."},
        "columns": {"type": "integer", "minimum": 1, "maximum": 200, "description": "Modules across the table width (along u)."},
        "module_gap_x_m": {"type": "number", "minimum": 0, "maximum": 5, "description": "Gap between columns, in the table plane."},
        "module_gap_y_m": {"type": "number", "minimum": 0, "maximum": 5, "description": "Gap between rows, in the table plane."},
        "tilt_deg": {"type": "number", "minimum": 0, "maximum": 80},
        "facing_azimuth_deg": {"type": "number", "minimum": -3600, "maximum": 3600, "description": "Clockwise from frame north; normalized to [0, 360)."},
        "lower_edge_height_m": {"type": "number", "minimum": 0, "maximum": 50, "description": "Synthetic height of the lower edge above the layout's relative flat datum."}
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "anchor_xy_m", "table_gap_m", "row_pitch_m", "minimum_clear_row_gap_m"],
      "properties": {
        "mode": {"enum": ["fixed_lattice", "phase_search_3x3"]},
        "anchor_xy_m": {"$ref": "#/$defs/position2"},
        "table_gap_m": {"type": "number", "minimum": 0, "maximum": 1000},
        "row_pitch_m": {"type": "number", "exclusiveMinimum": 0, "maximum": 10000, "description": "Lower edge to lower edge, horizontal, along v."},
        "minimum_clear_row_gap_m": {"type": "number", "minimum": 0, "maximum": 1000}
      }
    }
  },
  "$defs": {
    "position2": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"type": "number"}
    },
    "position": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {"type": "number"},
      "description": "[x, y]. A third (Z) value is rejected after this schema as UNSUPPORTED_INPUT."
    },
    "ring": {"type": "array", "minItems": 1, "maxItems": 100000, "items": {"$ref": "#/$defs/position"}},
    "polygon_coordinates": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/ring"}},
    "areal_geometry": {
      "type": "object",
      "required": ["type", "coordinates"],
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["Polygon", "MultiPolygon"]},
        "coordinates": {"type": "array"}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "Polygon"}}},
          "then": {"properties": {"coordinates": {"$ref": "#/$defs/polygon_coordinates"}}}
        },
        {
          "if": {"properties": {"type": {"const": "MultiPolygon"}}},
          "then": {"properties": {"coordinates": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/polygon_coordinates"}}}}
        }
      ]
    }
  }
}
